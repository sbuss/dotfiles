ZD=$HOME/.zsh

. $ZD/all_platforms.zsh

case $(uname -s) in
  Darwin)
    . $ZD/osx.zsh
    ;;
  Linux)
    . $ZD/linux.zsh
    ;;
esac

# Put nvm's default node ahead of Homebrew's node (added by osx.zsh above), so
# node/npm/npx/pnpm/yarn/corepack all come from the same nvm-managed version.
prepend_default_node_to_path

. $ZD/aliases.zsh

# Load gcloud completions before compinit to avoid double initialization
if [ -f '/Users/sbuss/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/sbuss/Downloads/google-cloud-sdk/path.zsh.inc'; fi
if [ -f '/Users/sbuss/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/sbuss/Downloads/google-cloud-sdk/completion.zsh.inc'; fi

. $ZD/completion.zsh
. $ZD/prompt.zsh
. $ZD/autosuggestions.zsh
export PATH="$HOME/.local/bin:$PATH"

alias blaude="CLAUDE_CONFIG_DIR=~/.claude-bacio claude --dangerously-skip-permissions"
eval "$(direnv hook zsh)"

export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"
